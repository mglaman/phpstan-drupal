parameters:
	level: 8
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		-
			identifier: missingType.iterableValue
		-
			identifier: missingType.generics
		-
			# The replacement API needs PHPStan 2.3, but we support ^2.1. See #1061.
			identifier: class.implementsDeprecatedInterface
			path: src/Drupal/BootstrapResultCacheMetaExtension.php
	paths:
		- src
		- drupal-autoloader.php
		- tests/src
	excludePaths:
		-  tests/src/data/*.php
		-  tests/src/Generics/data/*.php
		-  tests/src/Type/data/*.php
		-  tests/src/Rules/data/*.php
		-  tests/src/DeprecatedScope/data/*.php
	dynamicConstantNames:
		- Drupal::VERSION
		- Symfony\Component\HttpKernel\Kernel::MAJOR_VERSION
includes:
	- phpstan-baseline.neon
